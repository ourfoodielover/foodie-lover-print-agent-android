<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Networking ─────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Bluetooth: legacy (API ≤30) vs runtime (API 31+) ─────────────────────
         BLUETOOTH/BLUETOOTH_ADMIN cover pre-Android-12 devices (maxSdkVersion caps
         them there so they don't linger as unused legacy permissions on new OSes).
         BLUETOOTH_CONNECT is required on API 31+ to connect to an already-bonded
         RFCOMM device. BLUETOOTH_SCAN is requested too (neverForLocation, since this
         app only ever connects to an already-paired printer and never scans for
         nearby unpaired devices for location purposes). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- ── Foreground service (Android 9+ requires the permission; Android 14+
         additionally requires declaring the specific service type permission) ─── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- ── Notifications (required at runtime on Android 13+ for the persistent
         "Print Service running" notification the foreground service must show) ── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Boot recovery ─────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Battery-optimization exemption prompt (Section B of the Phase 0 analysis:
         required for the foreground service to survive Doze/App Standby reliably) ── -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- CN811 is Bluetooth Classic only in this build; BLE hardware is not required. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:name=".PrintAgentApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.PrintAgent"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.DevicePickerActivity"
            android:exported="false"
            android:label="@string/device_picker_title"
            android:parentActivityName=".ui.SettingsActivity" />

        <!-- The single owner of the poll/print loop. connectedDevice type is used because
             the service's entire job is maintaining a Bluetooth peripheral connection. -->
        <service
            android:name=".service.PrintService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
