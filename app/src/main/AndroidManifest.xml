<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Bluetooth legacy API 30 and below, and runtime API 31 and above.
        BLUETOOTH and BLUETOOTH_ADMIN cover pre-Android-12 devices.
        BLUETOOTH_CONNECT is required on API 31+ to connect to an
        already-bonded RFCOMM device.
        BLUETOOTH_SCAN uses neverForLocation because this application
        does not use Bluetooth scanning for location purposes.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Foreground service permissions -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Notification permission for Android 13 and above -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot recovery -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Battery optimization exemption -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- CN811 uses Bluetooth Classic. BLE hardware is not required. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:name=".PrintAgentApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PrintAgent"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.DevicePickerActivity"
            android:exported="false"
            android:label="@string/device_picker_title"
            android:parentActivityName=".ui.SettingsActivity" />

        <!--
            PrintService owns the polling and printing loop.
            The connectedDevice service type is used because the service
            maintains a Bluetooth peripheral connection.
        -->
        <service
            android:name=".service.PrintService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>